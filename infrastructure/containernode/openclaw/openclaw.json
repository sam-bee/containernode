{
  "meta": {
    "lastTouchedVersion": "2026.7.1",
    "lastTouchedAt": "2026-08-15T06:45:00.000Z"
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "openai/gpt-5.6-sol"
      }
    },
    "list": [
      {
        "id": "default",
        "default": true,
        "name": "Codex (OpenClaw)",
        "workspace": "~/.openclaw/workspace"
      },
      {
        "id": "grok-number1",
        "name": "grok-number1",
        "description": "Experimental Grok-backed security-research assistant",
        "workspace": "~/.openclaw/workspace-grok-number1",
        "model": {
          "primary": "xai/grok-4.6"
        },
        "thinkingDefault": "off",
        "tools": {
          "allow": [
            "exec",
            "web_search"
          ],
          "elevated": {
            "enabled": false
          },
          "exec": {
            "host": "node",
            "node": "research",
            "security": "full",
            "ask": "off",
            "strictInlineEval": false,
            "timeoutSec": 60
          }
        }
      },
      {
        "id": "personal",
        "name": "personal",
        "description": "Private DeepSeek-backed personal assistant",
        "workspace": "~/.openclaw/workspace-personal",
        "model": {
          "primary": "deepseek/deepseek-v4-pro"
        },
        "thinkingDefault": "xhigh",
        "tools": {
          "allow": []
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "default",
      "comment": "Route the original Codex Matrix account to the default OpenClaw agent",
      "match": {
        "channel": "matrix",
        "accountId": "codex"
      }
    },
    {
      "agentId": "grok-number1",
      "comment": "Route the dedicated grok-number1 Matrix account to its isolated agent",
      "match": {
        "channel": "matrix",
        "accountId": "grok-number1"
      }
    },
    {
      "agentId": "personal",
      "comment": "Route the dedicated personal Matrix account to its isolated DeepSeek agent",
      "match": {
        "channel": "matrix",
        "accountId": "personal"
      }
    }
  ],
  "plugins": {
    "allow": [
      "codex",
      "deepseek",
      "matrix",
      "xai"
    ],
    "entries": {
      "codex": {
        "enabled": true
      },
      "deepseek": {
        "enabled": true
      },
      "matrix": {
        "enabled": true
      },
      "xai": {
        "enabled": true,
        "config": {
          "codeExecution": {
            "enabled": false
          },
          "xSearch": {
            "enabled": false
          }
        }
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "grok"
      }
    }
  },
  "channels": {
    "matrix": {
      "enabled": true,
      "defaultAccount": "codex",
      "homeserver": "http://synapse.matrix.svc.cluster.local",
      "network": {
        "dangerouslyAllowPrivateNetwork": true
      },
      "encryption": true,
      "allowBots": false,
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "@sierra:matrix"
      ],
      "accounts": {
        "codex": {
          "name": "Codex (OpenClaw)",
          "userId": "@codex:matrix",
          "accessToken": "${OPENCLAW_MATRIX_CODEX_ACCESS_TOKEN}",
          "deviceId": "WRYNNMKMBH",
          "deviceName": "OpenClaw on containernode",
          "encryption": true
        },
        "grok-number1": {
          "name": "grok-number1",
          "userId": "@grok-number1:matrix",
          "accessToken": "${MATRIX_GROK_NUMBER1_ACCESS_TOKEN}",
          "deviceId": "IMVNNEEDTG",
          "deviceName": "OpenClaw grok-number1 on containernode",
          "encryption": true,
          "historyLimit": 20
        },
        "personal": {
          "name": "personal",
          "userId": "@personal:matrix",
          "accessToken": "${MATRIX_PERSONAL_ACCESS_TOKEN}",
          "deviceId": "ENBHYMFOID",
          "deviceName": "OpenClaw personal on containernode",
          "encryption": true,
          "historyLimit": 20
        }
      },
      "groups": {
        "!vbyFNpnEQVrFnIhHgx:matrix": {
          "account": "codex",
          "enabled": true,
          "requireMention": true,
          "allowBots": false,
          "users": [
            "@sierra:matrix"
          ],
          "tools": {
            "allow": []
          }
        },
        "!AFevwmXOiPKDVYXVZR:matrix": {
          "account": "grok-number1",
          "enabled": true,
          "requireMention": true,
          "allowBots": "mentions",
          "botLoopProtection": {
            "enabled": true,
            "maxEventsPerWindow": 4,
            "windowSeconds": 300,
            "cooldownSeconds": 300
          },
          "users": [
            "@sierra:matrix"
          ],
          "tools": {
            "allow": [
              "exec",
              "web_search"
            ]
          }
        },
        "!biJYZfayIzCAfLrPPM:matrix": {
          "account": "personal",
          "enabled": true,
          "requireMention": true,
          "allowBots": false,
          "users": [
            "@sierra:matrix"
          ],
          "tools": {
            "allow": []
          }
        }
      },
      "dm": {
        "enabled": false,
        "policy": "disabled",
        "sessionScope": "per-room"
      },
      "execApprovals": {
        "enabled": true,
        "approvers": [
          "@sierra:matrix"
        ],
        "agentFilter": [
          "grok-number1"
        ],
        "target": "channel"
      },
      "autoJoin": "allowlist",
      "autoJoinAllowlist": [
        "!vbyFNpnEQVrFnIhHgx:matrix",
        "!AFevwmXOiPKDVYXVZR:matrix",
        "!biJYZfayIzCAfLrPPM:matrix"
      ],
      "threadReplies": "inbound",
      "replyToMode": "off",
      "streaming": "off"
    }
  },
  "cron": {
    "enabled": false
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  }
}
