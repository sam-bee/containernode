{
  "meta": {
    "lastTouchedVersion": "2026.8.1-beta.2"
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "xai": {
        "baseUrl": "https://api.x.ai/v1",
        "api": "openai-responses",
        "models": [
          {
            "id": "grok-4.6",
            "name": "Grok 4.6",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 2,
              "output": 6,
              "cacheRead": 0.5,
              "cacheWrite": 0
            },
            "contextWindow": 500000,
            "maxTokens": 64000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "low",
                "medium",
                "high",
                "xhigh"
              ],
              "toolSchemaProfile": "xai",
              "unsupportedToolSchemaKeywords": [
                "minContains",
                "maxContains"
              ],
              "toolCallArgumentsEncoding": "html-entities"
            },
            "thinkingLevelMap": {
              "off": null,
              "minimal": "low",
              "low": "low",
              "medium": "medium",
              "high": "high",
              "xhigh": "xhigh"
            }
          }
        ]
      },
      "local-qwen": {
        "baseUrl": "${THREE_EIGHT_BASE_URL}",
        "apiKey": "local-qwen",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "/mnt/internal-ssd-2/ai/5070/models/Qwen3.8-27B-Uncensored-IQ3_M.gguf",
            "name": "Qwen 3.8 27B Uncensored IQ3_M",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 17152,
            "maxTokens": 4096,
            "compat": {
              "supportsReasoningEffort": false,
              "supportsTemperature": true,
              "supportsTools": false,
              "maxTokensField": "max_tokens",
              "thinkingFormat": "qwen"
            }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "openai/gpt-5.6-sol"
      }
    },
    "list": [
      {
        "id": "default",
        "default": true,
        "name": "Codex (OpenClaw)",
        "workspace": "~/.openclaw/workspace"
      },
      {
        "id": "grok-number1",
        "name": "grok-number1",
        "description": "Experimental Grok-backed security-research assistant",
        "workspace": "~/.openclaw/workspace-grok-number1",
        "model": {
          "primary": "xai/grok-4.6"
        },
        "thinkingDefault": "xhigh",
        "tools": {
          "allow": [
            "exec",
            "web_search"
          ],
          "elevated": {
            "enabled": false
          },
          "exec": {
            "host": "node",
            "node": "research",
            "security": "full",
            "ask": "off",
            "strictInlineEval": false
          }
        }
      },
      {
        "id": "personal",
        "name": "personal",
        "description": "Private DeepSeek-backed personal assistant",
        "workspace": "~/.openclaw/workspace-personal",
        "model": {
          "primary": "deepseek/deepseek-v4-pro"
        },
        "thinkingDefault": "xhigh",
        "tools": {
          "allow": []
        }
      },
      {
        "id": "3-8",
        "name": "3-8",
        "description": "Private Qwen-backed personal-diary assistant",
        "workspace": "~/.openclaw/workspace-3-8",
        "model": {
          "primary": "local-qwen//mnt/internal-ssd-2/ai/5070/models/Qwen3.8-27B-Uncensored-IQ3_M.gguf"
        },
        "thinkingDefault": "off",
        "tools": {
          "allow": []
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "default",
      "comment": "Route the original Codex Matrix account to the default OpenClaw agent",
      "match": {
        "channel": "matrix",
        "accountId": "codex"
      }
    },
    {
      "agentId": "grok-number1",
      "comment": "Route the dedicated grok-number1 Matrix account to its isolated agent",
      "match": {
        "channel": "matrix",
        "accountId": "grok-number1"
      }
    },
    {
      "agentId": "personal",
      "comment": "Route the dedicated personal Matrix account to its isolated DeepSeek agent",
      "match": {
        "channel": "matrix",
        "accountId": "personal"
      }
    },
    {
      "agentId": "3-8",
      "comment": "Route the dedicated 3-8 Matrix account to its isolated personal-diary agent",
      "match": {
        "channel": "matrix",
        "accountId": "3-8"
      }
    }
  ],
  "plugins": {
    "load": {
      "paths": [
        "/app/node_modules/@openclaw/codex"
      ]
    },
    "allow": [
      "codex",
      "deepseek",
      "matrix",
      "xai"
    ],
    "entries": {
      "codex": {
        "enabled": true
      },
      "deepseek": {
        "enabled": true
      },
      "matrix": {
        "enabled": true
      },
      "xai": {
        "enabled": true,
        "config": {
          "codeExecution": {
            "enabled": false
          },
          "xSearch": {
            "enabled": false
          }
        }
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "grok"
      }
    }
  },
  "channels": {
    "matrix": {
      "enabled": true,
      "defaultAccount": "codex",
      "homeserver": "http://synapse.matrix.svc.cluster.local",
      "network": {
        "dangerouslyAllowPrivateNetwork": true
      },
      "encryption": true,
      "allowBots": false,
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "@sierra:matrix"
      ],
      "accounts": {
        "codex": {
          "name": "Codex (OpenClaw)",
          "userId": "@codex:matrix",
          "accessToken": "${OPENCLAW_MATRIX_CODEX_ACCESS_TOKEN}",
          "deviceId": "WRYNNMKMBH",
          "deviceName": "OpenClaw on containernode",
          "encryption": true
        },
        "grok-number1": {
          "name": "grok-number1",
          "userId": "@grok-number1:matrix",
          "accessToken": "${MATRIX_GROK_NUMBER1_ACCESS_TOKEN}",
          "deviceId": "IMVNNEEDTG",
          "deviceName": "OpenClaw grok-number1 on containernode",
          "encryption": true,
          "historyLimit": 20
        },
        "personal": {
          "name": "personal",
          "userId": "@personal:matrix",
          "accessToken": "${MATRIX_PERSONAL_ACCESS_TOKEN}",
          "deviceId": "ENBHYMFOID",
          "deviceName": "OpenClaw personal on containernode",
          "encryption": true,
          "historyLimit": 20
        },
        "3-8": {
          "name": "3-8",
          "userId": "@3-8:matrix",
          "accessToken": "${MATRIX_3_8_ACCESS_TOKEN}",
          "deviceId": "PMGVHIVFVM",
          "deviceName": "OpenClaw 3-8 on containernode",
          "encryption": true,
          "historyLimit": 20
        }
      },
      "groups": {
        "!vbyFNpnEQVrFnIhHgx:matrix": {
          "account": "codex",
          "enabled": true,
          "requireMention": true,
          "allowBots": false,
          "users": [
            "@sierra:matrix"
          ],
          "tools": {
            "allow": []
          }
        },
        "!AFevwmXOiPKDVYXVZR:matrix": {
          "account": "grok-number1",
          "enabled": true,
          "requireMention": true,
          "allowBots": "mentions",
          "botLoopProtection": {
            "enabled": true,
            "maxEventsPerWindow": 4,
            "windowSeconds": 300,
            "cooldownSeconds": 300
          },
          "users": [
            "@sierra:matrix"
          ],
          "tools": {
            "allow": [
              "exec",
              "web_search"
            ]
          }
        },
        "!biJYZfayIzCAfLrPPM:matrix": {
          "account": "personal",
          "enabled": true,
          "requireMention": true,
          "allowBots": false,
          "users": [
            "@sierra:matrix"
          ],
          "tools": {
            "allow": []
          }
        },
        "!afdgSePKBUXaovUtNJ:matrix": {
          "account": "3-8",
          "enabled": true,
          "requireMention": true,
          "allowBots": false,
          "users": [
            "@sierra:matrix"
          ],
          "tools": {
            "allow": []
          }
        }
      },
      "dm": {
        "enabled": false,
        "policy": "disabled",
        "sessionScope": "per-room"
      },
      "execApprovals": {
        "enabled": true,
        "approvers": [
          "@sierra:matrix"
        ],
        "agentFilter": [
          "grok-number1"
        ],
        "target": "channel"
      },
      "autoJoin": "allowlist",
      "autoJoinAllowlist": [
        "!vbyFNpnEQVrFnIhHgx:matrix",
        "!AFevwmXOiPKDVYXVZR:matrix",
        "!biJYZfayIzCAfLrPPM:matrix",
        "!afdgSePKBUXaovUtNJ:matrix"
      ],
      "threadReplies": "inbound",
      "replyToMode": "off",
      "streaming": {
        "mode": "off"
      }
    }
  },
  "cron": {
    "enabled": false
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  }
}
